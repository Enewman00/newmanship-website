---
import AppLandingLayout from '@/layouts/AppLandingLayout.astro';
import ScreenshotSection from '@/components/marketing/ScreenshotSection.astro';
import { getEntry } from 'astro:content';
import { generateMobileApplicationSchema } from '@/utils/seo';

const app = await getEntry('apps', 'sproutawake');
const { name, tagline, description, category, platforms, appStoreUrl, playStoreUrl, features, faqs, colors, iconPath } = app.data;

const siteUrl = 'https://newmanship.com';
const pageUrl = `${siteUrl}/sproutawake/`;
const appleAppId = '6761698232';
const tiktokUrl = 'https://www.tiktok.com/@sprout.alarm';

// Keep in sync with the App Store listing - shown on the page and in structured data
const rating = { value: 4.8, count: 54 };
const pricing = { monthly: '4.99', annual: '29.99' };

const appSchema = generateMobileApplicationSchema({
  name,
  description,
  pageUrl,
  appStoreUrl: appStoreUrl!,
  applicationCategory: 'HealthApplication',
  applicationSubCategory: 'Alarm Clock',
  operatingSystem: 'iOS 26.0 or later',
  image: `${siteUrl}${iconPath}`,
  screenshots: [1, 2, 3].map((n) => `${siteUrl}/screenshots/sprout-alarm-${n}.png`),
  offers: [
    { name: 'SproutAwake (free download)', price: '0' },
    { name: 'SproutAwake Pro, Monthly', price: pricing.monthly },
    { name: 'SproutAwake Pro, Annual', price: pricing.annual },
  ],
  rating,
  profiles: [tiktokUrl],
  author: 'Ethan Newman',
  siteUrl,
});

const facts = [
  { label: 'What it is', value: 'An alarm clock app for heavy sleepers that plants real trees' },
  { label: 'Platform', value: 'iPhone, iOS 26 or later' },
  { label: 'Price', value: `Free download. Pro is $${pricing.monthly}/month or $${pricing.annual}/year` },
  { label: 'Wake-up missions', value: 'Math problems, phone shaking, puzzles, word unscrambles, finding a household object' },
  { label: 'Tree-planting partner', value: 'One Tree Planted - 50% of proceeds donated' },
  { label: 'Monthly tree updates', value: 'Posted on TikTok at @sprout.alarm' },
  { label: 'App Store rating', value: `${rating.value} out of 5 (${rating.count} ratings)` },
  { label: 'Developer', value: 'Ethan Newman, Newmanship' },
];

const steps = [
  {
    title: 'Set your alarm',
    body: 'Choose your wake time and a wake-up mission. Setup takes under a minute, and alarms ring through Silent mode and Focus.',
  },
  {
    title: 'Complete your wake-up mission',
    body: 'Solve a math problem, shake your phone, finish a puzzle, unscramble a word, or find a household object. No snoozing your way out - beating your alarm earns points and keeps your streak alive.',
  },
  {
    title: 'Watch your impact grow',
    body: '50% of SproutAwake proceeds go to One Tree Planted. Monthly tree-planting updates are posted on TikTok at @sprout.alarm.',
  },
];
---

<AppLandingLayout
  title="SproutAwake - Loud Alarm for Heavy Sleepers That Plants Trees"
  description="Free iPhone alarm clock for heavy sleepers. Loud alarms and wake-up missions get you up, and 50% of proceeds plant trees with One Tree Planted."
  canonicalUrl={pageUrl}
  image="/og/sprout-alarm.png"
  name={name}
  tagline={tagline}
  appDescription={description}
  category={category}
  platforms={platforms}
  appStoreUrl={appStoreUrl}
  playStoreUrl={playStoreUrl}
  iconPath={iconPath}
  features={features}
  faqs={faqs}
  colors={colors}
  appleAppId={appleAppId}
  appSchema={appSchema}
  ctaHeading="Wake up. Make a difference."
  ctaSubheading="Every morning counts - for you and the planet."
>
  <!-- App Store rating: visible counterpart to aggregateRating in the structured data -->
  <a
    slot="hero-extra"
    href={appStoreUrl}
    class="inline-flex items-center gap-2 mt-6 text-sm text-brand-ink-muted hover:text-brand-ink"
  >
    <span aria-hidden="true" style={`color: ${colors.accent};`}>★★★★★</span>
    <span><strong class="text-brand-ink">{rating.value}</strong> on the App Store · {rating.count} ratings</span>
  </a>

  <!-- Impact banner: quick social-proof stat above the features -->
  <section slot="custom-section" style={`background-color: ${colors.accent};`} class="py-10 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <p class="text-white font-bold text-lg mb-1">50% of proceeds plant trees with One Tree Planted.</p>
      <p class="text-white/80 text-sm">
        A verified reforestation nonprofit active in over 80 countries. Monthly tree-planting updates on TikTok at @sprout.alarm.
      </p>
    </div>
  </section>

  <!-- At a glance: plain-text facts that search engines and AI answers can quote directly -->
  <section slot="custom-section" class="py-16 bg-brand-bg">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-brand-ink mb-4 text-center">SproutAwake at a glance</h2>
      <p class="text-brand-ink-muted text-center mb-8 max-w-2xl mx-auto">
        SproutAwake is an iPhone alarm clock for heavy sleepers. It combines loud alarm sounds with
        wake-up missions you must complete to turn the alarm off, and donates 50% of its proceeds to
        One Tree Planted, so every morning you get up helps plant real trees.
      </p>
      <dl class="divide-y divide-black/5 rounded-2xl bg-brand-surface border border-black/5">
        {facts.map((fact) => (
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4 px-6 py-4">
            <dt class="text-sm font-semibold text-brand-ink">{fact.label}</dt>
            <dd class="text-sm text-brand-ink-muted sm:col-span-2">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- How Your Mornings Plant Trees - detailed impact section -->
  <section class="py-20 bg-brand-surface">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-brand-ink mb-4 text-center">How Your Mornings Plant Trees</h2>
      <p class="text-brand-ink-muted text-center mb-16 max-w-xl mx-auto">
        Every alarm is a chance to do something good. Here's how it works.
      </p>

      <div class="flex flex-col lg:flex-row items-center gap-16">
        <!-- CSS phone mockup showing SproutAwake interface -->
        <div class="flex-shrink-0 flex justify-center">
          <div
            class="relative w-60 rounded-[2.5rem] border-4 shadow-2xl overflow-hidden"
            style={`border-color: ${colors.accent}; background-color: ${colors.background};`}
          >
            <!-- Status bar -->
            <div
              class="flex justify-between items-center px-5 py-2 text-xs text-white font-medium"
              style={`background-color: ${colors.accent};`}
            >
              <span>7:00 AM</span>
              <span>100%</span>
            </div>

            <!-- Alarm face -->
            <div class="text-center pt-5 pb-2 px-4">
              <div class="text-4xl font-bold mb-0.5" style={`color: ${colors.accent};`}>7:00</div>
              <div class="text-xs text-brand-ink-muted mb-4">Good morning!</div>

              <!-- Wake challenge card -->
              <div
                class="rounded-xl p-3 mb-3 border"
                style={`background-color: white; border-color: ${colors.accent}40;`}
              >
                <p class="text-xs text-brand-ink-muted font-semibold uppercase tracking-wide mb-1">Wake-Up Mission</p>
                <p class="text-sm font-bold text-brand-ink mb-2">Solve to dismiss</p>
                <p class="text-2xl font-bold" style={`color: ${colors.accent};`}>14 + 8 = ?</p>
                <div class="mt-3 grid grid-cols-3 gap-1">
                  <div class="text-sm font-semibold py-1 rounded-lg border text-center" style={`border-color: ${colors.accent}; color: ${colors.accent};`}>18</div>
                  <div
                    class="text-sm font-semibold py-1 rounded-lg text-center text-white"
                    style={`background-color: ${colors.accent};`}
                  >22</div>
                  <div class="text-sm font-semibold py-1 rounded-lg border text-center" style={`border-color: ${colors.accent}; color: ${colors.accent};`}>21</div>
                </div>
              </div>

              <!-- Eco points display -->
              <div class="rounded-xl p-3" style={`background-color: ${colors.accent}18;`}>
                <div class="flex items-center justify-center gap-2">
                  <!-- Sprout icon -->
                  <svg class="w-6 h-6 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style={`color: ${colors.accent};`} aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 22V12M12 12C12 8 8 5 4 5c0 4 3 7 8 7zM12 12C12 8 16 5 20 5c0 4-3 7-8 7z" />
                  </svg>
                  <div class="text-left">
                    <p class="text-xs text-brand-ink-muted leading-none">Points</p>
                    <p class="text-base font-bold leading-none mt-0.5" style={`color: ${colors.accent};`}>247 pts</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Impact footer -->
            <div class="px-4 py-3 mt-2 text-center" style={`background-color: ${colors.accent};`}>
              <p class="text-white text-xs font-medium">3 trees planted this month</p>
            </div>
          </div>
        </div>

        <!-- Step-by-step explanation -->
        <div class="flex-1 space-y-10">
          {steps.map((step, i) => (
            <div class="flex gap-4 items-start">
              <div
                class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center font-bold text-white text-sm"
                style={`background-color: ${colors.accent};`}
              >
                {i + 1}
              </div>
              <div>
                <h3 class="font-semibold text-brand-ink mb-1">{step.title}</h3>
                <p class="text-brand-ink-muted text-sm leading-relaxed">{step.body}</p>
              </div>
            </div>
          ))}

          <!-- Reforestation partner note -->
          <div
            class="rounded-xl p-4 border"
            style={`background-color: ${colors.accent}10; border-color: ${colors.accent}30;`}
          >
            <p class="text-sm text-brand-ink leading-relaxed">
              <span class="font-semibold" style={`color: ${colors.accent};`}>Our reforestation promise: </span>
              50% of proceeds go to <a href="https://onetreeplanted.org/" class="underline">One Tree Planted</a>,
              a verified reforestation nonprofit planting in over 80 countries. See the trees planted each
              month on TikTok at <a href={tiktokUrl} class="underline">@sprout.alarm</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ScreenshotSection
    heading="Every morning, make a difference"
    subheading="A clear, motivating interface that makes waking up feel like an achievement."
    accentColor={colors.accent}
    appBackground={colors.background}
    backgroundClass="bg-brand-background"
    screenshots={[
      {
        src: '/screenshots/sprout-alarm-1.png',
        srcWebp: '/screenshots/sprout-alarm-1.webp',
        alt: 'SproutAwake set alarm screen with time picker and wake-up mission selection',
        caption: 'Pick your wake time and mission.',
      },
      {
        src: '/screenshots/sprout-alarm-2.png',
        srcWebp: '/screenshots/sprout-alarm-2.webp',
        alt: 'SproutAwake wake-up mission screen with a math problem to dismiss the alarm',
        caption: 'Solve to dismiss - no snoozing.',
      },
      {
        src: '/screenshots/sprout-alarm-3.png',
        srcWebp: '/screenshots/sprout-alarm-3.webp',
        alt: 'SproutAwake impact tracker showing points and trees planted',
        caption: 'Track your real-world impact.',
      },
    ]}
  />
</AppLandingLayout>
